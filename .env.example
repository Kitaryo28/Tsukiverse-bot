# --- required ---
DISCORD_TOKEN=paste_your_bot_token_here

# --- website dashboard (optional: leave DISCORD_CLIENT_SECRET empty to turn the website off) ---
# Developer Portal -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=
# The public address people use to open the dashboard. Add  <this>/callback  under OAuth2 -> Redirects.
DASHBOARD_URL=http://localhost:8080
# Port to listen on (many hosts set PORT for you)
DASHBOARD_PORT=8080

# --- optional ---
# Where settings and XP are stored. Point this at a persistent disk/volume on your host.
# DATA_DIR=/app/data
# Keeps dashboard logins valid across restarts (auto-generated and saved in DATA_DIR if you leave it out)
# SESSION_SECRET=any-long-random-string

# --- music (optional) ---
# If YouTube says "sign in to confirm you're not a bot" on a hosted server, export a cookies.txt from a
# browser where you're logged in to a throwaway Google account and point this at it.
# YTDLP_COOKIES=/app/data/cookies.txt
# Only if ffmpeg isn't on the PATH:
# FFMPEG_PATH=/usr/bin/ffmpeg

# Bot status line (optional). Type: watching / playing / listening / competing
STATUS_TEXT=love you ❤️ | 28 watching
STATUS_TYPE=watching
